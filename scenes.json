{
  "scenes": [
    {
      "start": 0.0,
      "end": 2.5,
      "text": "আসসালামু আলাইকুম ওয়ারাহমাতুল্লাহ।",
      "type": "respectful",
      "duration": 2.5
    },
    {
      "start": 2.5,
      "end": 6.5,
      "text": "আজকের একটি হাদিস যা আমাদের পুরো জীবনটাই বদলে দিতে পারে।",
      "type": "informative",
      "duration": 4.0
    },
    {
      "start": 6.5,
      "end": 10.5,
      "text": "আলকামা ইবনে ওয়াক্কাস লাইসী রহমাতুল্লাহি আলাইহি থেকে বর্ণিত,",
      "type": "informative",
      "duration": 4.0
    },
    {
      "start": 10.5,
      "end": 15.0,
      "text": "আমি ওমর ইবনুল খাত্তাব রাদিয়াল্লাহু আনহুকে মিমবরের উপর দাঁড়িয়ে বলতে শুনেছি, তিনি বলেছেন—",
      "type": "informative",
      "duration": 4.5
    },
    {
      "start": 15.0,
      "end": 18.5,
      "text": "আমি রাসুলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লামকে এরশাদ করতে শুনেছি—",
      "type": "respectful",
      "duration": 3.5
    },
    {
      "start": 18.5,
      "end": 20.8,
      "text": "ইন্নামাল আ'মালু বিন নিয়্যাত।",
      "type": "solemn",
      "duration": 2.3
    },
    {
      "start": 20.8,
      "end": 23.5,
      "text": "প্রত্যেক কাজ নিয়তের সাথে সম্পর্কিত।",
      "type": "informative",
      "duration": 2.7
    },
    {
      "start": 23.5,
      "end": 26.0,
      "text": "ওয়া ইন্নামা লিকুল্লিম রিইম মা নাওয়া।",
      "type": "solemn",
      "duration": 2.5
    },
    {
      "start": 26.0,
      "end": 28.5,
      "text": "আর মানুষ তার নিয়ত অনুযায়ী ফল পাবে।",
      "type": "informative",
      "duration": 2.5
    },
    {
      "start": 28.5,
      "end": 32.5,
      "text": "তাই যার হিজরত হবে দুনিয়া লাভের অথবা কোনো নারীকে বিয়ে করার উদ্দেশ্যে,",
      "type": "informative",
      "duration": 4.0
    },
    {
      "start": 32.5,
      "end": 36.0,
      "text": "সেই উদ্দেশ্যই হবে তার হিজরতের প্রাপ্য।",
      "type": "serious",
      "duration": 3.5
    },
    {
      "start": 36.0,
      "end": 38.5,
      "text": "সহিহ বুখারি, হাদিস নম্বর এক।",
      "type": "calm",
      "duration": 2.5
    },
    {
      "start": 38.5,
      "end": 40.2,
      "text": "চিন্তা করুন,",
      "type": "thoughtful",
      "duration": 1.7
    },
    {
      "start": 40.2,
      "end": 42.5,
      "text": "একই কাজ দুজন মানুষ করছে।",
      "type": "informative",
      "duration": 2.3
    },
    {
      "start": 42.5,
      "end": 44.8,
      "text": "একজন করছে আল্লাহর জন্য,",
      "type": "calm",
      "duration": 2.3
    },
    {
      "start": 44.8,
      "end": 47.2,
      "text": "আরেকজন করছে মানুষকে দেখানোর জন্য।",
      "type": "serious",
      "duration": 2.4
    },
    {
      "start": 47.2,
      "end": 49.8,
      "text": "বাইরে থেকে দেখতে একই রকম,",
      "type": "calm",
      "duration": 2.6
    },
    {
      "start": 49.8,
      "end": 53.0,
      "text": "কিন্তু আল্লাহর কাছে আকাশ পাতাল পার্থক্য।",
      "type": "solemn",
      "duration": 3.2
    },
    {
      "start": 53.0,
      "end": 56.5,
      "text": "আপনার নামাজ, আপনার রোজা, আপনার দান,",
      "type": "warm",
      "duration": 3.5
    },
    {
      "start": 56.5,
      "end": 60.0,
      "text": "এমনকি আপনার ঘুমটাও ইবাদত হয়ে যাবে, যদি নিয়তটা ঠিক থাকে।",
      "type": "warm",
      "duration": 3.5
    },
    {
      "start": 60.0,
      "end": 62.5,
      "text": "নিয়ত হলো আমাদের অন্তরের গল্প।",
      "type": "thoughtful",
      "duration": 2.5
    },
    {
      "start": 62.5,
      "end": 66.0,
      "text": "দুনিয়া দেখে আমাদের কাজ, আর আল্লাহ দেখেন আমাদের নিয়ত।",
      "type": "solemn",
      "duration": 3.5
    },
    {
      "start": 66.0,
      "end": 69.5,
      "text": "তাই আজ থেকে কোনো কাজ শুরু করার আগে এক সেকেন্ড থামুন।",
      "type": "compassionate",
      "duration": 3.5
    },
    {
      "start": 69.5,
      "end": 72.0,
      "text": "নিজেকে জিজ্ঞেস করুন, আমি এটা কেন করছি?",
      "type": "thoughtful",
      "duration": 2.5
    },
    {
      "start": 72.0,
      "end": 74.8,
      "text": "নিয়ত ঠিক করুন, জীবন ঠিক হয়ে যাবে ইনশাল্লাহ।",
      "type": "optimistic",
      "duration": 2.8
    },
    {
      "start": 74.8,
      "end": 76.2,
      "text": "এই ছিল আজকের হাদিস।",
      "type": "friendly",
      "duration": 1.4
    },
    {
      "start": 76.2,
      "end": 78.0,
      "text": "ভালো লাগলে শেয়ার করে অন্যকে জানার সুযোগ করে দিন।",
      "type": "encouraging",
      "duration": 1.8
    },
    {
      "start": 78.0,
      "end": 82.0,
      "text": "আজই প্লে ষ্টোর থেকে ইনষ্টল করুন ❝ইসলামী বিশ্বকোষ ও আল হাদিস S2❞ আ্যপটি",
      "type": "store",
      "duration": 4.0
    }
  ]
}